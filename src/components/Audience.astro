---
import { audience } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section audience" id="audience">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{audience.eyebrow}</p>
      <h2 class="h2">{audience.heading}</h2>
      <p class="lede">{audience.lede}</p>
    </div>

    <ul class="platforms" data-reveal>
      {audience.platforms.map((p) => (
        <li>
          <a class="platform card" href={p.href} target="_blank" rel="noopener">
            <div class="platform__top">
              <span class="platform__icon">
                <Icon name={p.id} size={20} />
              </span>
              <span class="platform__name">{p.name}</span>
              <Icon name="arrow-up-right" size={18} class="platform__ext" />
            </div>
            <div class="platform__metric">
              {p.metric} <span class="platform__metric-label">{p.metricLabel}</span>
            </div>
            <p class="platform__detail">{p.detail}</p>
            <span class="platform__handle">{p.handle}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="demo" data-reveal>
      <div class="demo__head">
        <h3 class="demo__title">Who’s watching</h3>
        <p class="demo__note">{audience.demographicsNote}</p>
      </div>
      <ul class="bars">
        {audience.demographics.map((d) => (
          <li class="bar">
            <div class="bar__row">
              <span class="bar__label">{d.label}</span>
              <span class="bar__value">
                {d.value}
                {d.suffix}
              </span>
            </div>
            <div class="bar__track" role="presentation">
              <div class="bar__fill" style={`--w:${d.value}%`} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .platform {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 22px 20px;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .platform:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--line-strong);
  }
  .platform__top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .platform__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--bg-sunken);
    color: var(--ink);
  }
  .platform__name {
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 0.9375rem;
  }
  .platform__ext {
    margin-left: auto;
    color: var(--ink-3);
    transition: transform 0.25s var(--ease);
  }
  .platform:hover .platform__ext {
    transform: translate(2px, -2px);
    color: var(--ink);
  }
  .platform__metric {
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .platform__metric-label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-3);
    margin-left: 2px;
  }
  .platform__detail {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .platform__handle {
    margin-top: auto;
    padding-top: 18px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .demo {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 5vw, 72px);
    margin-top: clamp(40px, 6vw, 72px);
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius-lg);
    background: var(--dark);
    color: var(--dark-ink);
  }
  .demo__title {
    font-size: 1.5rem;
    color: var(--dark-ink);
  }
  .demo__note {
    margin-top: 12px;
    font-size: 0.9375rem;
    color: var(--dark-ink-2);
    max-width: 40ch;
  }
  .bars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bar__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
    font-size: 0.9375rem;
  }
  .bar__value {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .bar__track {
    height: 8px;
    border-radius: 999px;
    background: var(--dark-line);
    overflow: hidden;
  }
  .bar__fill {
    width: var(--w);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #3b82f6, #93c5fd);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1s var(--ease) 0.2s;
  }
  .is-visible .bar__fill {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .bar__fill {
      transform: none;
    }
  }

  @media (max-width: 899px) {
    .platforms {
      grid-template-columns: 1fr 1fr;
    }
    .demo {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .platforms {
      grid-template-columns: 1fr;
    }
    .bars {
      grid-template-columns: 1fr;
    }
  }
</style>
