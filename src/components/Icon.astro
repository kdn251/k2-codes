---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={stroked ? 'none' : 'currentColor'}
  stroke={stroked ? 'currentColor' : 'none'}
  stroke-width={stroked ? 2 : undefined}
  stroke-linecap={stroked ? 'round' : undefined}
  stroke-linejoin={stroked ? 'round' : undefined}
>
  <path d={paths[name]}></path>
</svg>
