---
import { site, nav } from '../data/site';
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="brand" href="#top" aria-label={`${site.name} home`}>
      <img class="brand__avatar" src={site.portrait.src} alt="" width="36" height="36" />
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list" id="nav-list">
        {nav.map((item) => (
          <li>
            <a class="nav__link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav__cta-mobile">
          <a class="btn btn--primary" href="#contact">
            Work with me
          </a>
        </li>
      </ul>
    </nav>

    <a class="btn btn--primary header__cta" href="#contact">
      Work with me
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-list" data-menu-btn>
      <span class="visually-hidden">Menu</span>
      <span class="menu-btn__bar"></span>
      <span class="menu-btn__bar"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const list = document.getElementById('nav-list');

  const setOpen = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    btn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  list?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }
  .header.is-scrolled {
    border-bottom-color: var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.0625rem;
  }
  .brand__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 60% 30%;
  }
  .nav {
    margin-left: auto;
  }
  .nav__list {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .nav__link:hover {
    color: var(--ink);
    background: var(--bg-sunken);
  }
  .nav__cta-mobile {
    display: none;
  }
  .header__cta {
    min-height: 42px;
    padding-inline: 18px;
  }
  .menu-btn {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .menu-btn__bar {
    position: absolute;
    left: 12px;
    width: 20px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition:
      transform 0.3s var(--ease),
      top 0.3s var(--ease);
  }
  .menu-btn__bar:nth-child(2) {
    top: 17px;
  }
  .menu-btn__bar:nth-child(3) {
    top: 25px;
  }
  .is-open .menu-btn__bar:nth-child(2) {
    top: 21px;
    transform: rotate(45deg);
  }
  .is-open .menu-btn__bar:nth-child(3) {
    top: 21px;
    transform: rotate(-45deg);
  }

  @media (max-width: 899px) {
    .header__inner {
      height: 64px;
    }
    .header__cta {
      display: none;
    }
    .menu-btn {
      display: block;
      margin-left: auto;
    }
    .nav {
      position: fixed;
      inset: 64px 0 0 0;
      margin: 0;
      background: var(--bg);
      padding: 16px var(--gutter) 32px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 0.25s var(--ease),
        transform 0.25s var(--ease),
        visibility 0s linear 0.25s;
    }
    .is-open .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
    .nav__list {
      flex-direction: column;
      gap: 4px;
    }
    .nav__link {
      display: block;
      padding: 14px 8px;
      font-size: 1.375rem;
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--ink);
      border-radius: var(--radius-sm);
    }
    .nav__cta-mobile {
      display: block;
      margin-top: 16px;
    }
    .nav__cta-mobile .btn {
      width: 100%;
    }
  }
</style>
