---
import { partners } from '../data/site';

// Each logo is painted through a CSS mask so every brand renders in the same
// ink colour at the same visual weight regardless of the source artwork.
// `scale` nudges wordmarks that read too small or too large next to the others.
---

<section class="partners section--tight" aria-labelledby="partners-title">
  <div class="container">
    <p class="partners__title" id="partners-title">
      Brands I've worked with
    </p>
    <ul class="wall">
      {partners.map((p) => (
        <li class="wall__cell">
          <a
            class="brand"
            href={p.href}
            target={p.href ? '_blank' : undefined}
            rel={p.href ? 'noopener' : undefined}
            title={p.note}
          >
            <span
              class="brand__logo"
              role="img"
              aria-label={p.name}
              style={`--logo:url('${p.logo}');--scale:${p.scale ?? 1}`}
            />
            <span class="visually-hidden">{p.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(40px, 5vw, 56px);
  }
  .partners__title {
    margin-bottom: 28px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .wall {
    --cols: 6;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .wall__cell {
    background: var(--bg);
  }
  .brand {
    display: grid;
    place-items: center;
    height: 104px;
    padding: 0 20px;
    color: var(--ink-2);
    transition:
      color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }
  .brand:hover {
    color: var(--ink);
    background: var(--bg-elevated);
  }
  .brand__logo {
    display: block;
    width: 100%;
    max-width: 150px;
    height: 40px;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transform: scale(var(--scale));
  }

  @media (max-width: 1023px) {
    .wall {
      --cols: 4;
    }
  }
  @media (max-width: 639px) {
    .wall {
      --cols: 3;
    }
    .brand {
      height: 84px;
      padding: 0 14px;
    }
    .brand__logo {
      height: 32px;
    }
  }
  @media (max-width: 379px) {
    .wall {
      --cols: 2;
    }
  }
</style>
