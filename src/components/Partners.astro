---
import { partners } from '../data/site';

// Two rows scrolling in opposite directions. The second row starts half-way
// through the list so different brands are on screen at any moment.
// Each track repeats its row three times; the animation moves exactly one
// third of the track width, so the loop is seamless and the copies are
// hidden from assistive tech.
const half = Math.ceil(partners.length / 2);
const rows = [partners, [...partners.slice(half), ...partners.slice(0, half)]];
---

<section class="partners section--tight" aria-labelledby="partners-title">
  <div class="container">
    <p class="partners__title" id="partners-title">
      Brands I've worked with
    </p>
  </div>

  <div class="rows">
    {rows.map((row, r) => (
      <div class={`marquee marquee--${r === 0 ? 'left' : 'right'}`}>
        <div class="marquee__track" style={`--count:${row.length}`}>
          {[0, 1, 2].map((copy) => (
            <ul class="marquee__group" aria-hidden={copy > 0 || r > 0 ? 'true' : undefined}>
              {row.map((p) => (
                <li class="brand">
                  <a
                    class="brand__link"
                    href={p.href}
                    target={p.href ? '_blank' : undefined}
                    rel={p.href ? 'noopener' : undefined}
                    tabindex={copy > 0 || r > 0 ? -1 : undefined}
                    title={p.note ?? p.name}
                  >
                    <span
                      class="brand__logo"
                      role="img"
                      aria-label={p.name}
                      style={`--logo:url('${p.logo}');--scale:${p.scale ?? 1}`}
                    />
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .partners {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(36px, 5vw, 56px);
    overflow: hidden;
  }
  .partners__title {
    margin-bottom: 28px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .rows {
    display: grid;
    gap: 22px;
  }
  .marquee {
    --fade: clamp(40px, 8vw, 140px);
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--fade),
      #000 calc(100% - var(--fade)),
      transparent
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--fade),
      #000 calc(100% - var(--fade)),
      transparent
    );
  }
  .marquee__track {
    display: flex;
    width: max-content;
    /* ~2.6s per logo keeps the speed steady however long the list gets. */
    animation: scroll-left calc(var(--count) * 2.6s) linear infinite;
  }
  .marquee--right .marquee__track {
    animation-name: scroll-right;
    animation-duration: calc(var(--count) * 3s);
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__group {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .brand {
    flex: none;
  }
  .brand__link {
    display: grid;
    place-items: center;
    height: 64px;
    padding: 0 clamp(22px, 3vw, 40px);
    color: var(--ink-2);
    transition: color 0.25s var(--ease);
  }
  .brand__link:hover {
    color: var(--ink);
  }
  .brand__logo {
    display: block;
    width: 150px;
    height: 36px;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transform: scale(var(--scale));
  }

  @keyframes scroll-left {
    to {
      transform: translateX(calc(-100% / 3));
    }
  }
  @keyframes scroll-right {
    from {
      transform: translateX(calc(-100% / 3));
    }
    to {
      transform: translateX(0);
    }
  }

  @media (max-width: 639px) {
    .brand__link {
      height: 52px;
    }
    .brand__logo {
      width: 120px;
      height: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rows {
      gap: 0;
    }
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .marquee--right {
      display: none;
    }
    .marquee__track {
      animation: none;
      width: auto;
      justify-content: center;
    }
    .marquee__group[aria-hidden] {
      display: none;
    }
    .marquee__group {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 8px;
    }
  }
</style>
