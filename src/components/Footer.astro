---
import { site, nav, socials, footer } from '../data/site';
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <p class="footer__name">{site.name}</p>
      <p class="footer__tagline">{footer.tagline}</p>
      <p class="footer__legal">{footer.legal}</p>
    </div>
    <nav aria-label="Footer">
      <p class="footer__heading">Site</p>
      <ul class="footer__list">
        {nav.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
          </li>
        ))}
        <li>
          <a href="#contact">Contact</a>
        </li>
      </ul>
    </nav>
    <div>
      <p class="footer__heading">Elsewhere</p>
      <ul class="footer__list">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 56px 0 40px;
    background: var(--dark);
    color: var(--dark-ink-2);
    border-top: 1px solid var(--dark-line);
    font-size: 0.9375rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--dark-ink);
  }
  .footer__tagline {
    margin-top: 8px;
    max-width: 36ch;
  }
  .footer__legal {
    margin-top: 24px;
    font-size: 0.8125rem;
  }
  .footer__heading {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer__list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__list a {
    color: var(--dark-ink);
    opacity: 0.8;
    transition: opacity 0.2s var(--ease);
  }
  .footer__list a:hover {
    opacity: 1;
  }
  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: span 2;
    }
  }
</style>
